# Apollo Security account
SITE_USERNAME=
SITE_PASSWORD=

# WhatsApp Web linked-device setup
# Blank sends alerts to the linked WhatsApp account's own chat.
# Optional: international phone number using digits only, e.g. 972501234567
WHATSAPP_RECIPIENT=
WHATSAPP_BRIDGE_PORT=3021
WHATSAPP_COMMAND_PORT=3022
WHATSAPP_STARTUP_TIMEOUT_SECONDS=180
WHATSAPP_MESSAGE_DELAY_SECONDS=2
# WHATSAPP_AUTH_DIR=.whatsapp-auth
# SUBSCRIBERS_FILE=.whatsapp_subscribers.json

# Monitor settings
POLL_INTERVAL_SECONDS=3600
HEARTBEAT_MINUTES=5
HEADLESS=true
RETRY_DELAY_SECONDS=5
# USER_AGENT=
